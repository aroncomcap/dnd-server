{
  "name": "dnd-ai-server",
  "version": "1.0.0",
  "description": "Multiplayer D&D 5e game server with Claude as Dungeon Master",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@nicokaiser/passport-apple": "^3.3.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.26.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "resend": "^6.11.0",
    "socket.io": "^4.7.2",
    "stripe": "^22.0.1",
    "together-ai": "^0.39.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=22.8.0"
  }
}
